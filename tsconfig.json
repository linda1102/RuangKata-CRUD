{
  "compilerOptions":{
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist", //Folder hasil compile ke JS
    "rootDir": "./src", //Folder tempat kode TS 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "drizzle.config.ts"]
}
